# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free + tool-calling. Paid alternative if the free pool gets flaky: google/gemini-2.5-flash
# FALLBACK_MODELS is a comma-separated list OpenRouter routes to on a 429.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Embeddings run locally (all-MiniLM via chromadb's ONNX runtime) — no key, no cost.

# Optional overrides; the defaults are absolute paths inside backend/, leave them alone
# unless you need to move them.
# CHROMA_DIR=.chroma
# DATABASE_URL=sqlite:///orders.db
# ADMIN_TOKEN=demo-token
# CORS_ORIGINS=https://your-app.vercel.app
